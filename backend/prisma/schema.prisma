generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  CENTER_ADMIN
  SUPER_ADMIN
}

enum ExamType {
  READING
  LISTENING
  WRITING
  SPEAKING
  MOCK_CEFR
  MOCK_IELTS
  IELTS_ACADEMIC
  IELTS_GENERAL
  CEFR_B1
  CEFR_B2
  CEFR_C1
}

enum QuestionType {
  MCQ
  FILL_BLANKS
  MATCHING
  ESSAY
  SPEAKING
  TRUE_FALSE
  SHORT_ANSWER
  LEXICAL_CHOICE
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum NotificationType {
  EXAM_REMINDER
  RESULT_READY
  PROCTOR_WARNING
  SYSTEM
  PAYMENT_UPDATE
}

enum ManualPaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ResultStatus {
  IN_PROGRESS
  COMPLETED
  SUBMITTED
  GRADED
  FLAGGED
}

enum MockPartStatus {
  DRAFT
  ACTIVE
}

enum MockPartAttemptStatus {
  IN_PROGRESS
  COMPLETED
}

enum SkillType {
  LISTENING
  READING
  WRITING
  SPEAKING
  LEXICAL_COMPETENCE
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String?
  googleId      String?  @unique
  name          String
  role          Role     @default(STUDENT)
  avatar        String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  exams                 Exam[]
  results               Result[]
  speakingRecords       SpeakingRecord[]
  writingSubmissions    WritingSubmission[]
  subscription          Subscription?
  analytics             Analytics?
  achievements          Achievement[]
  mockReports           MockReport[]
  xp                    Int      @default(0)
  streak                Int      @default(0)
  centerId              String?
  teacherId             String?
  phone                 String?

  center                  Center?              @relation(fields: [centerId], references: [id])
  notifications           Notification[]
  proctorLogs             ProctorLog[]
  aiReports               AiReport[]
  manualExamPayments      ManualExamPayment[]  @relation("StudentManualPayments")
  reviewedManualPayments  ManualExamPayment[]  @relation("ManualPaymentReviewer")
  examEntitlements        ExamEntitlement[]
  auditLogsAsActor        AuditLog[]           @relation("AuditActor")
  auditLogsAsSubject      AuditLog[]           @relation("AuditSubject")
  aiUsageLogs             AiUsageLog[]

  @@index([role, createdAt])
  @@index([centerId])
  @@map("users")
}

model Center {
  id                   String   @id @default(uuid())
  name                 String
  address              String?
  phone                String?
  email                String?
  avatar               String?
  mockLimit            Int?
  adminEmail           String?  @unique
  adminPassword        String?
  paymentInstructions  String?
  isVip                Boolean  @default(false)
  createdAt            DateTime @default(now()) @map("created_at")

  users  User[]
  exams  Exam[]

  @@map("centers")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model ProctorLog {
  id         String   @id @default(uuid())
  userId     String
  resultId   String?
  eventType  String
  detail     Json?
  screenshot String?  // Base64 screenshot (if applicable)
  timestamp  DateTime @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  result Result? @relation(fields: [resultId], references: [id])

  @@index([userId, resultId, timestamp])
  @@index([resultId, eventType])
  @@index([eventType])
  @@map("proctor_logs")
}

/// Manual bank transfer / receipt — admin approves to unlock one exam attempt.
model ManualExamPayment {
  id              String              @id @default(uuid())
  userId          String
  examId          String
  amountNote      String?
  currency        String              @default("UZS")
  screenshotKey   String
  status          ManualPaymentStatus @default(PENDING)
  reviewerId      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  user       User              @relation("StudentManualPayments", fields: [userId], references: [id], onDelete: Cascade)
  exam       Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  reviewer   User?             @relation("ManualPaymentReviewer", fields: [reviewerId], references: [id])
  entitlement ExamEntitlement?

  @@index([status, createdAt])
  @@index([userId, examId])
  @@map("manual_exam_payments")
}

/// One approved payment grants a single exam sitting until submit consumes it.
model ExamEntitlement {
  id              String    @id @default(uuid())
  userId          String
  examId          String
  manualPaymentId String   @unique
  consumedAt      DateTime?
  createdAt       DateTime  @default(now()) @map("created_at")

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam    Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  payment ManualExamPayment @relation(fields: [manualPaymentId], references: [id], onDelete: Cascade)

  @@index([userId, examId, consumedAt])
  @@map("exam_entitlements")
}

model AiReport {
  id         String   @id @default(uuid())
  userId     String
  kind       String
  model      String?
  tokensUsed Int?
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@map("ai_reports")
}

model AiUsageLog {
  id           String   @id @default(uuid())
  userId       String?
  endpoint     String
  model        String
  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int?
  success      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage_logs")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  user  User? @relation("AuditSubject", fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model Exam {
  id                  String      @id @default(uuid())
  title               String
  type                ExamType
  duration            Int
  level               String?
  centerId            String?
  createdBy           String
  requiresPayment     Boolean     @default(true)
  priceUzs            Int?
  paymentInstructions String?     @db.Text
  isPublished         Boolean     @default(false)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  creator            User                 @relation(fields: [createdBy], references: [id])
  center             Center?              @relation(fields: [centerId], references: [id])
  questions          Question[]
  results            Result[]
  manualExamPayments ManualExamPayment[]
  entitlements       ExamEntitlement[]
  examParts          ExamPart[]

  @@index([type, createdAt])
  @@index([createdBy])
  @@index([centerId])
  @@map("exams")
}

model Question {
  id          String        @id @default(uuid())
  examId      String
  examPartId  String?
  skill       String?      // READING, LISTENING, WRITING, SPEAKING, LEXICAL_COMPETENCE
  part        String?      // e.g., "1", "1.1", "2", "3", etc.
  subPart     String?      // e.g., "1", "2", "3" for list items within a part
  question    String       // Question text (can be HTML for rich content)
  type        QuestionType
  options     Json?        // Array of options for MCQ
  answer      String?      // Correct answer
  passage     String?      // Reading passage or audio transcript
  mediaUrl    String?      // URL to audio/image file
  order       Int          @default(0)
  points      Int          @default(1)
  createdAt   DateTime     @default(now())

  exam        Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  examPart    ExamPart?   @relation(fields: [examPartId], references: [id])
  userAnswers UserAnswer[]

  @@index([examId, order])
  @@index([examId, skill, part])
  @@map("questions")
}

model Result {
  id                String       @id @default(uuid())
  userId            String
  examId            String
  score             Float        @default(0)
  ieltsBand         Float?       // IELTS band score (0-9)
  cefrLevel         String?      // CEFR level (A1-C2)
  skillScores       Json?        // Individual skill scores
  answers           Json?        // Complete answers object
  integrityScore    Float?       // Proctoring integrity score (0-100)
  integrityReport   Json?        // Detailed proctoring report
  aiFeedback        Json?        // AI feedback for writing/speaking
  timeSpent         Int?         // Total time spent in seconds
  status            ResultStatus @default(IN_PROGRESS)
  startedAt         DateTime     @default(now()) @map("started_at")
  completedAt       DateTime?    @map("completed_at")
  createdAt         DateTime     @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id])
  exam        Exam        @relation(fields: [examId], references: [id])
  userAnswers UserAnswer[]
  proctorLogs ProctorLog[]

  @@index([userId, createdAt])
  @@index([examId, createdAt])
  @@index([status])
  @@index([integrityScore])
  @@map("results")
}

model SpeakingRecord {
  id                     String   @id @default(uuid())
  userId                 String
  questionId             String?
  audioUrl               String?
  audioStorageKey        String?
  transcript             String?
  sttProvider            String?
  pauseMetrics           Json?
  segmentMetadata        Json?
  fluencyScore           Float?
  grammarScore           Float?
  pronunciationScore     Float?
  overallScore           Float?
  estimatedSpeakingCefr  String?
  pronunciationAnalysis  Json?
  fluencyAnalysis        Json?
  feedback               String?  @db.Text
  duration               Int?     // Duration in seconds
  createdAt              DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([estimatedSpeakingCefr])
  @@map("speaking_records")
}

model ExamPart {
  id          String   @id @default(uuid())
  examId      String
  skill       String   // LISTENING, READING, WRITING, SPEAKING, LEXICAL_COMPETENCE
  partNumber  String   // "1", "1.1", "2", etc.
  title       String
  duration    Int      // Duration in minutes for this part
  order       Int
  createdAt   DateTime @default(now())

  exam       Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions  Question[]

  @@unique([examId, skill, partNumber])
  @@index([examId, skill])
  @@map("exam_parts")
}

model UserAnswer {
  id          String   @id @default(uuid())
  resultId    String
  questionId  String
  answer      String?  // User's answer
  isCorrect   Boolean?
  points      Float    @default(0)
  timeSpent   Int?     // Time spent in seconds
  createdAt   DateTime @default(now())

  result   Result   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])
  userId   String

  @@index([resultId])
  @@index([questionId])
  @@index([userId])
  @@map("user_answers")
}

model MediaFile {
  id          String   @id @default(uuid())
  fileName    String
  fileType    String   // "AUDIO", "IMAGE", "PDF"
  fileUrl     String
  fileSize    Int
  uploadedBy  String
  createdAt   DateTime @default(now())

  @@index([fileType])
  @@map("media_files")
}

model WritingSubmission {
  id               String   @id @default(uuid())
  userId           String
  essay            String   @db.Text
  wordCount        Int?
  aiFeedback       String?  @db.Text
  grammarScore     Float?
  vocabScore       Float?
  coherenceScore   Float?
  estimatedLevel   String?
  grammarAnalysis  Json?
  vocabularyAnalysis Json?
  coherenceAnalysis Json?
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("writing_submissions")
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String             @unique
  plan      SubscriptionPlan   @default(FREE)
  status    SubscriptionStatus @default(PENDING)
  expiresAt DateTime?
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([plan, status])
  @@map("subscriptions")
}

model Analytics {
  id            String   @id @default(uuid())
  userId        String   @unique
  studyTime     Int      @default(0)
  weakSkills    Json?
  progressScore Float    @default(0)
  totalExams    Int      @default(0)
  avgScore      Float    @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("analytics")
}

model Achievement {
  id        String   @id @default(uuid())
  userId    String
  title     String
  icon      String?
  xpReward  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("achievements")
}

model MockReport {
  id                   String   @id @default(uuid())
  userId               String
  testId               String?
  testType             String
  readingScore         Float
  listeningScore       Float
  writingText          String   @db.Text
  speakingTranscript   String   @db.Text
  aiResponse           Json
  createdAt            DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([testId])
  @@map("mock_reports")
}

model SiteSettings {
  id                      String   @id @default(uuid())
  siteName                String   @default("MockCEFR")
  siteDescription         String   @default("CEFR va IELTS mock test platformasi")
  contactEmail            String   @default("info@mockcefr.uz")
  contactPhone            String   @default("+998 90 123 45 67")
  pricing                 Json     @default("{\"cefrMockPrice\": 50000, \"ieltsMockPrice\": 70000}")
  examSettings            Json     @default("{\"defaultTimeLimit\": 120, \"maxAttempts\": 3, \"autoSubmitOnTimeout\": true}")
  paymentInstructions     String?
  maintenanceMode         Boolean  @default(false)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model MockPart {
  id              String          @id @default(uuid())
  title           String
  type            String
  skill           String
  partNumber      Int
  questions       Json
  audioUrl        String?
  audioPlaysOnce  Boolean         @default(true)
  passageText     String?         @db.Text
  passageFile     String?
  price           Int             @default(0)
  status          MockPartStatus  @default(DRAFT)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  attempts        MockPartAttempt[]

  @@index([type, skill, partNumber])
  @@index([status])
  @@map("mock_parts")
}

model MockPartAttempt {
  id             String                 @id @default(uuid())
  studentId      String
  mockPartId     String
  answers        Json
  score          Float                 @default(0)
  totalQuestions Int                   @default(0)
  status         MockPartAttemptStatus @default(IN_PROGRESS)
  startedAt      DateTime              @default(now()) @map("started_at")
  completedAt    DateTime?             @map("completed_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  mockPart       MockPart @relation(fields: [mockPartId], references: [id], onDelete: Cascade)

  @@index([studentId, mockPartId])
  @@index([status])
  @@map("mock_part_attempts")
}

model PaymentCard {
  id              String   @id @default(uuid())
  cardNumber      String
  cardHolderName  String
  bankName        String
  cardType        String
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("payment_cards")
}

model MockPayment {
  id              String   @id @default(uuid())
  studentId       String
  mockPartId      String
  amount          Int
  checkImageUrl   String
  status          String   @default("pending")
  aiVerdict       Json?
  reviewedAt      DateTime?
  reviewerId      String?
  rejectionReason String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([studentId, mockPartId])
  @@index([status])
  @@map("mock_payments")
}

model IeltsMock {
  id          String   @id @default(cuid())
  title       String
  type        String   // 'Academic' | 'General'
  level       String   // 'B1' | 'B2' | 'C1' | 'C2'
  description String?
  duration    Int      // total duration in minutes (175 = 2h 55m)
  price       Float    @default(0)
  isPaid      Boolean  @default(false)
  status      String   @default("draft") // 'draft' | 'published'
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  listening   IeltsListening?
  reading     IeltsReading?
  writing     IeltsWriting?
  speaking    IeltsSpeaking?
  attempts    IeltsAttempt[]

  @@index([type, level, status])
  @@map("ielts_mocks")
}

model IeltsListening {
  id        String     @id @default(cuid())
  mockId    String     @unique
  mock      IeltsMock  @relation(fields: [mockId], references: [id], onDelete: Cascade)
  duration  Int        @default(30)
  sections  Json       // array of sections with audioUrl + questions
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("ielts_listening")
}

model IeltsReading {
  id        String     @id @default(cuid())
  mockId    String     @unique
  mock      IeltsMock  @relation(fields: [mockId], references: [id], onDelete: Cascade)
  duration  Int        @default(60) // minutes
  passages  Json       // [{title, text, questions: [...]}]
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("ielts_reading")
}

model IeltsWriting {
  id        String     @id @default(cuid())
  mockId    String     @unique
  mock      IeltsMock  @relation(fields: [mockId], references: [id], onDelete: Cascade)
  duration  Int        @default(60) // minutes
  task1     Json       // {prompt, imageUrl?, minWords: 150}
  task2     Json       // {prompt, minWords: 250}
  aiWeights Json       @default("{\"taskAchievement\":25,\"coherence\":25,\"lexical\":25,\"grammar\":25}")
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("ielts_writing")
}

model IeltsSpeaking {
  id        String     @id @default(cuid())
  mockId    String     @unique
  mock      IeltsMock  @relation(fields: [mockId], references: [id], onDelete: Cascade)
  duration  Int        @default(15) // minutes
  part1     Json       // {questions: [...]}
  part2     Json       // {topic, prepTime: 60, speakTime: 120}
  part3     Json       // {questions: [...]}
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("ielts_speaking")
}

model IeltsAttempt {
  id               String     @id @default(cuid())
  mockId           String
  mock             IeltsMock  @relation(fields: [mockId], references: [id])
  userId           String
  status           String     @default("in_progress") // in_progress | completed
  listeningAnswers Json?
  readingAnswers   Json?
  writingAnswers   Json?
  speakingAnswers  Json?
  listeningScore   Float?
  readingScore     Float?
  writingScore     Float?
  speakingScore    Float?
  totalBand        String?     // "5.0", "5.5", "6.0"...
  answers          Json?
  feedback         Json?
  startedAt        DateTime   @default(now()) @map("started_at")
  completedAt      DateTime?  @map("completed_at")
  createdAt        DateTime   @default(now()) @map("created_at")

  @@index([mockId, userId])
  @@index([userId, status])
  @@map("ielts_attempts")
}

model CefrMock {
  id          String   @id @default(cuid())
  title       String
  level       String   // 'A1' | 'A2' | 'B1' | 'B2' | 'C1' | 'C2'
  description String?
  duration    Int      // total duration in minutes
  price       Float    @default(0)
  isPaid      Boolean  @default(false)
  status      String   @default("draft") // 'draft' | 'published'
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  listening   CefrListening?
  reading     CefrReading?
  writing     CefrWriting?
  speaking    CefrSpeaking?
  attempts    CefrAttempt[]

  @@index([level, status])
  @@map("cefr_mocks")
}

model CefrListening {
  id        String    @id @default(cuid())
  mockId    String    @unique @map("mock_id")
  mock      CefrMock  @relation(fields: [mockId], references: [id], onDelete: Cascade)
  duration  Int       @default(40) // minutes
  sections  Json      // [{part: 1, questions: [...]}]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("cefr_listening")
}

model CefrReading {
  id        String    @id @default(cuid())
  mockId    String    @unique @map("mock_id")
  mock      CefrMock  @relation(fields: [mockId], references: [id], onDelete: Cascade)
  duration  Int       @default(60) // minutes
  passages  Json      // [{title, text, questions: [...]}]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("cefr_reading")
}

model CefrWriting {
  id        String   @id @default(cuid())
  mockId    String   @unique @map("mock_id")
  mock      CefrMock @relation(fields: [mockId], references: [id], onDelete: Cascade)
  duration  Int      @default(80) // minutes
  task11    Json     // {prompt, minWords: 150}
  task12    Json     // {prompt, minWords: 150}
  task2     Json     // {prompt, minWords: 250}
  aiWeights Json     @default("{\"taskResponse\":25,\"coherence\":25,\"lexical\":25,\"grammar\":25}")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("cefr_writing")
}

model CefrSpeaking {
  id        String    @id @default(cuid())
  mockId    String    @unique @map("mock_id")
  mock      CefrMock  @relation(fields: [mockId], references: [id], onDelete: Cascade)
  duration  Int       @default(15) // minutes
  task1     Json      // {questions: [...]}
  task2     Json      // {topic, prepTime: 60, speakTime: 120}
  task3     Json      // {questions: [...]}
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("cefr_speaking")
}

model CefrAttempt {
  id               String    @id @default(cuid())
  mockId           String    @map("mock_id")
  mock             CefrMock  @relation(fields: [mockId], references: [id])
  userId           String    @map("user_id")
  status           String    @default("in_progress") // in_progress | completed
  listeningAnswers Json?
  readingAnswers   Json?
  writingAnswers   Json?
  speakingAnswers  Json?
  listeningScore   Float?
  readingScore     Float?
  writingScore     Float?
  speakingScore    Float?
  totalScore       Float?
  cefrLevel        String?
  answers          Json?
  feedback         Json?
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([mockId, userId])
  @@index([userId, status])
  @@map("cefr_attempts")
}
